<?xml version="1.0" encoding="UTF-8"?>
<!--
  jt-snmpd MSI definition (WiX v5)

  Why MSI is mandatory (spec §5.4):
    **Group Policy software installation accepts MSI and nothing else** — that
    one fact settles the choice. An EXE from Inno Setup or NSIS supports neither
    GPO software installation nor transactional rollback, and does not appear in
    Add/Remove Programs.

  MSI also brings, at no extra cost:
    - UpgradeCode handling: deploying a newer MSI is the upgrade; the old version
      does not have to be removed first
    - automatic rollback on a failed install
    - an Add/Remove Programs entry, visible both to customer asset inventories
      and through hrSWInstalledTable

  Decisions that matter:
    - the UpgradeCode **never changes** once published, or upgrades turn into
      side-by-side installations
    - the ProductCode differs for every version (WiX's * generates it)
    - configuration and state live under %ProgramData% and are **not in the MSI's
      component list**, so uninstalling does not remove them (spec §5.7: keeping
      them by default is deliberate)
    - the service is registered by a custom action rather than ServiceInstall,
      because sc failure, failureflag and privs are needed and WiX's
      ServiceInstall does not offer them
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="JT SNMP Agent"
           Manufacturer="Jason Tools"
           Version="$(var.ProductVersion)"
           UpgradeCode="7B3E9C24-5A61-4F8D-9E27-1C4A8B6D3F50"
           Language="1033"
           Codepage="65001"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <!-- Any earlier version with the same UpgradeCode is removed before this one
         is installed (a major upgrade). AfterInstallInitialize places the removal
         before the new files are copied, avoiding the classic MSI trap where
         removing the old version deletes the new files along with it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of JT SNMP Agent is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Platform and OS version requirements (spec §5.6 pre-checks) -->
    <Launch Condition="VersionNT >= 603"
            Message="Windows 10 / Server 2016 or newer is required." />
    <Launch Condition="Privileged"
            Message="Installing JT SNMP Agent requires administrator rights." />

    <!-- The management networks are mandatory. spec §3.3: deny by default, never
         Any/Any. Without them the installation stops rather than quietly opening
         the agent to the whole network. -->
    <Property Id="MANAGEMENTNETWORKS" Secure="yes" />
    <Launch Condition="MANAGEMENTNETWORKS OR REMOVE"
            Message="The management networks must be specified, for example: msiexec /i jt-snmpd.msi /qn MANAGEMENTNETWORKS=10.0.0.0/24" />

    <!-- The community is optional; without it the installer tries to migrate one
         from the built-in SNMP service.

         spec §5.5: **do not pass passwords as MSI properties** — they appear in
         the msiexec log and in Event IDs 1033 and 11707. A community string is a
         read-only access token and sits at a different risk level from a v3 key;
         v3 keys always go through ADMX policy and never through an MSI
         property. -->
    <Property Id="COMMUNITY" Secure="yes" />
    <Property Id="KEEPMSSNMP" Secure="yes" Value="0" />
    <Property Id="PURGE" Secure="yes" Value="0" />

    <!-- What appears in Add/Remove Programs -->
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://jason.tools" />
    <!-- ARPNOMODIFY comes from WixUI_InstallDir; defining it again here collides
         (WIX0091). ARPNOREPAIR is still set here: a repair re-runs the custom
         action, which would disable the built-in SNMP service again and overwrite
         the configuration — not what someone pressing "Repair" expects. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="JT SNMP Agent" />
    </StandardDirectory>

    <!-- The Add/Remove Programs icon.

         ARPPRODUCTICON pointing at the Icon table should be enough in theory, and
         in practice it produced no DisplayIcon at all: the property was present,
         the Icon table entry was present, the .ico was even re-encoded without
         PNG-compressed entries, and the registry value stayed empty.

         So DisplayIcon is written directly, pointing at the installed executable,
         which carries the icon anyway. This is what most installers do, and it
         does not depend on Windows Installer extracting the ICO. -->
    <Component Id="ArpDisplayIcon" Directory="INSTALLFOLDER"
               Guid="8F2C41A6-7D93-4E15-B0C8-3A9E5D7F2B41">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]"
                     Name="DisplayIcon" Type="string"
                     Value="[INSTALLFOLDER]jt-snmpd.exe" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="JT SNMP Agent" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="ArpDisplayIcon" />
    </Feature>

    <!-- ============ Custom actions ============
         The sequence deliberately mirrors install.ps1 so the two behave
         identically. PowerShell is invoked with -ExecutionPolicy Bypass because
         the execution policy on target machines is commonly Restricted — which is
         the default on Windows 11. -->

    <!-- [INSTALLFOLDER] expands **with a trailing backslash**
         ("C:\Program Files\JT SNMP Agent\"). Writing &quot;[INSTALLFOLDER]&quot;
         directly lets that backslash escape the closing quote,
         so PowerShell receives a path with a stray quote in it:
             cannot find C:\Program Files\JT SNMP Agent"\jt-snmpd.exe
         A classic MSI trap, and one this hit. The fix is to assemble the full
         script path first, after which the argument needs no directory. -->
    <!-- This must come **after** CostFinalize: directory properties such as
         INSTALLFOLDER are only resolved to real paths there. Placed earlier, the
         value comes out as a bare file name with no directory (measured:
         CONFIGSCRIPT = "msi-configure.ps1"), and the custom action cannot find
         the script. -->
    <SetProperty Id="CONFIGSCRIPT" Value="[INSTALLFOLDER]msi-configure.ps1"
                 After="CostFinalize" Sequence="execute" />

    <!-- Install: copy the built-in SNMP settings, disable it, write the config,
         set the ACL, register the service, add firewall rules, start it, and run
         the loopback health check -->
    <SetProperty Id="ConfigureAgent"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;[CONFIGSCRIPT]&quot; -ManagementNetworks &quot;[MANAGEMENTNETWORKS]&quot; -Community &quot;[COMMUNITY]&quot; -KeepMsSnmp &quot;[KEEPMSSNMP]&quot;"
                 Before="ConfigureAgent"
                 Sequence="execute" />
    <CustomAction Id="ConfigureAgent"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Uninstall: stop the service, remove the firewall rules, restore the
         built-in SNMP service -->
    <SetProperty Id="UnconfigureAgent"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;[CONFIGSCRIPT]&quot; -Uninstall -Purge &quot;[PURGE]&quot;"
                 Before="UnconfigureAgent"
                 Sequence="execute" />
    <CustomAction Id="UnconfigureAgent"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Removal has to happen before the files are deleted -->
      <Custom Action="UnconfigureAgent" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot;" />
      <!-- Configuration has to happen after the files are copied -->
      <Custom Action="ConfigureAgent" After="InstallFiles"
              Condition="NOT REMOVE" />
    </InstallExecuteSequence>


    <!-- ================= Graphical installation =================
      Silent installation (GPO, Intune, SCCM) is the primary delivery method, but
      double-clicking the MSI has to work too. Without a UI, double-clicking goes
      straight to installing with no opportunity to supply the management networks

      or the community, and the install then fails with "cannot determine a
      community".
    -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Dialog Id="JtSettingsDlg" Width="370" Height="270" Title="JT SNMP Agent">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Monitoring settings" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="330" Height="20"
                 Transparent="yes" NoPrefix="yes"
                 Text="These two decide who may query this host. They can be changed afterwards by editing config.json and restarting the service." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="NetLabel" Type="Text" X="20" Y="60" Width="330" Height="12"
                 NoPrefix="yes" Text="Management networks (required)" />
        <Control Id="NetHint" Type="Text" X="20" Y="73" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="Only these sources may query the agent, for example 10.0.0.0/24. Separate several with commas." />
        <Control Id="NetEdit" Type="Edit" X="20" Y="94" Width="330" Height="17"
                 Property="MANAGEMENTNETWORKS" Indirect="no" />

        <Control Id="CommLabel" Type="Text" X="20" Y="122" Width="330" Height="12"
                 NoPrefix="yes" Text="Community string (required)" />
        <Control Id="CommHint" Type="Text" X="20" Y="135" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="Equivalent to a read-only password. Left blank, the installer tries to carry one over from the built-in Windows SNMP service." />
        <Control Id="CommEdit" Type="Edit" X="20" Y="156" Width="330" Height="17"
                 Property="COMMUNITY" Indirect="no" />

        <Control Id="KeepMs" Type="CheckBox" X="20" Y="186" Width="330" Height="17"
                 Property="KEEPMSSNMP" CheckBoxValue="1"
                 Text="Keep the built-in Windows SNMP Service (by default it is disabled and restored on uninstall)" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <!-- Refuse to continue without management networks. spec §3.3 is deny by
               default and never Any/Any, and an empty list leaves the agent
               answering only loopback: installed, but not monitoring. -->
          <Publish Event="NewDialog" Value="VerifyReadyDlg"
                   Condition="MANAGEMENTNETWORKS" />
          <Publish Event="SpawnDialog" Value="JtNeedNetworksDlg"
                   Condition="NOT MANAGEMENTNETWORKS" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="JtNeedNetworksDlg" Width="260" Height="85" Title="JT SNMP Agent"
              NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="40"
                 NoPrefix="yes"
                 Text="Please enter the management networks. Without them the agent answers local queries only, which means it is installed but not monitoring." />
        <Control Id="OK" Type="PushButton" X="100" Y="60" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Splice the settings page into the standard flow:
           InstallDirDlg -> JtSettingsDlg -> VerifyReadyDlg -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="JtSettingsDlg" Order="3" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="JtSettingsDlg" Order="3" Condition="NOT Installed" />
    </UI>

    <!-- The Id must carry the .ico extension. The MSI Icon table takes the file
         name from Name, and without an extension Windows does not recognise it as
         an icon: ARPPRODUCTICON then points at nothing and DisplayIcon in
         Add/Remove Programs ends up empty (measured). -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />

  </Package>
</Wix>
