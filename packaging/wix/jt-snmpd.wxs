<?xml version="1.0" encoding="UTF-8"?>
<!--
  jt-snmpd MSI definition (WiX v5)

  Why MSI is mandatory :
    **Group Policy software installation accepts MSI and nothing else** — that
    one fact settles the choice. An EXE from Inno Setup or NSIS supports neither
    GPO software installation nor transactional rollback, and does not appear in
    Add/Remove Programs.

  MSI also brings, at no extra cost:
    - UpgradeCode handling: deploying a newer MSI is the upgrade; the old version
      does not have to be removed first
    - automatic rollback on a failed install
    - an Add/Remove Programs entry, visible both to customer asset inventories
      and through hrSWInstalledTable

  Decisions that matter:
    - the UpgradeCode **never changes** once published, or upgrades turn into
      side-by-side installations
    - the ProductCode differs for every version (WiX's * generates it)
    - configuration and state live under %ProgramData% and are **not in the MSI's
      component list**, so uninstalling does not remove them
    - the service is registered by a custom action rather than ServiceInstall,
      because sc failure, failureflag and privs are needed and WiX's
      ServiceInstall does not offer them
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="jt-snmpd"
           Manufacturer="Jason Tools"
           Version="$(var.ProductVersion)"
           UpgradeCode="7B3E9C24-5A61-4F8D-9E27-1C4A8B6D3F50"
           Language="1033"
           Codepage="65001"
           InstallerVersion="500"
           Scope="perMachine"
           Compressed="yes">

    <!-- Any earlier version with the same UpgradeCode is removed before this one
         is installed (a major upgrade). AfterInstallInitialize places the removal
         before the new files are copied, avoiding the classic MSI trap where
         removing the old version deletes the new files along with it. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of jt-snmpd is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Platform and OS version requirements  -->
    <Launch Condition="VersionNT >= 603"
            Message="Windows 10 / Server 2016 or newer is required." />
    <Launch Condition="Privileged"
            Message="Installing jt-snmpd requires administrator rights." />

    <!-- The management networks are mandatory. Deny by default, never Any/Any.
         Without them the installation stops rather than quietly opening the agent
         to the whole network.

         **The UILevel exemption is not optional.** LaunchConditions runs at the
         very start of the InstallUISequence, long before any dialog can collect
         a value, so without `UILevel > 4` this condition fires on the Welcome
         page of every double-click installation and the settings page can never
         be reached. That is exactly what happened: the graphical install path
         shipped in 0.9.2 was unusable, aborting with "the management networks
         must be specified" while the page that asks for them sat two clicks
         away.

         UILevel 5 is the full wizard, and only there does JtSettingsDlg exist to
         ask. It enforces the same requirement itself by refusing to advance past
         JtNeedNetworksDlg, so nothing is weakened. Every quieter level
         (2 = /qn, 3 = /qb, 4 = /qr) shows no wizard, so the condition still has
         to stop the install there. -->
    <Property Id="MANAGEMENTNETWORKS" Secure="yes" />
    <Launch Condition="MANAGEMENTNETWORKS OR REMOVE OR UILevel &gt; 4"
            Message="The management networks must be specified, for example: msiexec /i jt-snmpd.msi /qn MANAGEMENTNETWORKS=10.0.0.0/24" />

    <!-- The community is optional; without it the installer tries to migrate one
         from the built-in SNMP service.

         **do not pass passwords as MSI properties** — they appear in
         the msiexec log and in Event IDs 1033 and 11707. A community string is a
         read-only access token and sits at a different risk level from a v3 key;
         v3 keys always go through ADMX policy and never through an MSI
         property. -->
    <Property Id="COMMUNITY" Secure="yes" />
    <!-- No Value, and that is the whole point. A checkbox is drawn ticked when
         its property is **non-empty**, and "0" is a non-empty string: with
         Value="0" the box appeared ticked, next to a label saying the service
         would be kept, while the installer went on to disable it. Worse, the
         only way to actually keep the service was to untick and re-tick, since
         unticking clears the property to "" and only CheckBoxValue writes "1".
         Empty means unticked, ticking writes "1", and the configure script
         already treats anything other than "1" as "disable it", so all four
         paths finally agree. A silent install passes KEEPMSSNMP=1 to keep it. -->
    <Property Id="KEEPMSSNMP" Secure="yes" />
    <Property Id="PURGE" Secure="yes" Value="0" />

    <!-- What appears in Add/Remove Programs -->
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPHELPLINK" Value="https://jason.tools" />
    <!-- ARPNOMODIFY comes from WixUI_InstallDir; defining it again here collides
         (WIX0091). ARPNOREPAIR is still set here: a repair re-runs the custom
         action, which would disable the built-in SNMP service again and overwrite
         the configuration — not what someone pressing "Repair" expects. -->
    <Property Id="ARPNOREPAIR" Value="1" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="jt-snmpd" />
    </StandardDirectory>

    <!-- The Add/Remove Programs icon.

         ARPPRODUCTICON pointing at the Icon table should be enough in theory, and
         in practice it produced no DisplayIcon at all: the property was present,
         the Icon table entry was present, the .ico was even re-encoded without
         PNG-compressed entries, and the registry value stayed empty.

         So DisplayIcon is written directly, pointing at the installed executable,
         which carries the icon anyway. This is what most installers do, and it
         does not depend on Windows Installer extracting the ICO. -->
    <Component Id="ArpDisplayIcon" Directory="INSTALLFOLDER"
               Guid="8F2C41A6-7D93-4E15-B0C8-3A9E5D7F2B41">
      <RegistryValue Root="HKLM"
                     Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]"
                     Name="DisplayIcon" Type="string"
                     Value="[INSTALLFOLDER]jt-snmpd.exe" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="jt-snmpd" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="AgentFiles" />
      <ComponentRef Id="ArpDisplayIcon" />
    </Feature>

    <!-- ============ Custom actions ============
         The sequence deliberately mirrors install.ps1 so the two behave
         identically. PowerShell is invoked with -ExecutionPolicy Bypass because
         the execution policy on target machines is commonly Restricted — which is
         the default on Windows 11. -->

    <!-- [INSTALLFOLDER] expands **with a trailing backslash**
         ("C:\Program Files\jt-snmpd\"). Writing &quot;[INSTALLFOLDER]&quot;
         directly lets that backslash escape the closing quote,
         so PowerShell receives a path with a stray quote in it:
             cannot find C:\Program Files\jt-snmpd"\jt-snmpd.exe
         A classic MSI trap, and one this hit. The fix is to assemble the full
         script path first, after which the argument needs no directory. -->
    <!-- This must come **after** CostFinalize: directory properties such as
         INSTALLFOLDER are only resolved to real paths there. Placed earlier, the
         value comes out as a bare file name with no directory (measured:
         CONFIGSCRIPT = "msi-configure.ps1"), and the custom action cannot find
         the script. -->
    <SetProperty Id="CONFIGSCRIPT" Value="[INSTALLFOLDER]msi-configure.ps1"
                 After="CostFinalize" Sequence="execute" />

    <!-- Install: copy the built-in SNMP settings, disable it, write the config,
         set the ACL, register the service, add firewall rules, start it, and run
         the loopback health check -->
    <SetProperty Id="ConfigureAgent"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;[CONFIGSCRIPT]&quot; -ManagementNetworks &quot;[MANAGEMENTNETWORKS]&quot; -Community &quot;[COMMUNITY]&quot; -KeepMsSnmp &quot;[KEEPMSSNMP]&quot; -UILevel &quot;[UILevel]&quot;"
                 Before="ConfigureAgent"
                 Sequence="execute" />
    <CustomAction Id="ConfigureAgent"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />

    <!-- Uninstall: stop the service, remove the firewall rules, restore the
         built-in SNMP service -->
    <SetProperty Id="UnconfigureAgent"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -ExecutionPolicy Bypass -NoProfile -NonInteractive -File &quot;[CONFIGSCRIPT]&quot; -Uninstall -Purge &quot;[PURGE]&quot;"
                 Before="UnconfigureAgent"
                 Sequence="execute" />
    <CustomAction Id="UnconfigureAgent"
                  BinaryRef="Wix4UtilCA_X64"
                  DllEntry="WixQuietExec64"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- Removal has to happen before the files are deleted.

           REMOVE="ALL" alone is not "the product is being uninstalled".
           Windows Installer also sets it during a **repair**: with
           REINSTALL=ALL REINSTALLMODE=vomus the components are removed and
           re-added, so REMOVE was ALL, UnconfigureAgent ran, and ConfigureAgent
           did not, because "NOT REMOVE" was false. The service was deleted, the
           firewall rules were removed, the built-in SNMP Service was restored
           to Automatic, and **msiexec returned 0**. A repair left the machine
           with no agent and said it had succeeded.

           NOT REINSTALL excludes that case. NOT UPGRADINGPRODUCTCODE excludes
           the other one: during a major upgrade the old package's removal
           sequence runs, and it must not undo what the new one is installing. -->
      <Custom Action="UnconfigureAgent" Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT REINSTALL AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Configuration has to happen after the files are copied. A repair has
           to reach this too, which is the other half of the same defect. -->
      <Custom Action="ConfigureAgent" After="InstallFiles"
              Condition="NOT REMOVE OR REINSTALL" />
    </InstallExecuteSequence>


    <!-- ================= Graphical installation =================
      Silent installation (GPO, Intune, SCCM) is the primary delivery method, but
      double-clicking the MSI has to work too. Without a UI, double-clicking goes
      straight to installing with no opportunity to supply the management networks

      or the community, and the install then fails with "cannot determine a
      community".
    -->
    <!-- Without these three, WiX supplies its own placeholders: a red banner
         graphic, a stock side panel, and a licence page containing *Lorem
         ipsum*. The last of those is not cosmetic. It is a document presented as
         terms of use, saying nothing, for software that is actually licensed
         GPL-3.0-or-later. All three are generated by packaging/make-ui-assets.py
         from docs/brand/icon-512.png and the repository's own LICENSE, so they
         cannot drift from the project.

         The paths have to be absolute. A WixVariable value is resolved against
         the **working directory**, not against this file, so the bare names
         these started as failed the build with WIX0103 "Cannot find the Binary
         file 'banner.bmp'". UiDir is supplied by build-msi.ps1 the same way
         IconFile already is. -->
    <WixVariable Id="WixUIBannerBmp"  Value="$(var.UiDir)\banner.bmp" />
    <WixVariable Id="WixUIDialogBmp"  Value="$(var.UiDir)\dialog.bmp" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.UiDir)\license.rtf" />

    <!-- The last screen everyone sees. Until 1.1.3 it said "Click the Finish
         button" and nothing else, so somebody who installed by double-clicking
         finished with no way of learning that SNMPv3 exists: it is not on the
         settings page (passphrases must never be MSI properties), it was not in
         the README's installation section, and it was not on the project page.
         A feature nobody can find is close to a feature that is not there:
         the same defect as rate_pps and v3_only being live but invisible, which
         1.1.1 fixed for the configuration file and left standing here. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="SNMPv2c is ready to use. SNMPv3 (SHA-256 + AES-128, authPriv) is supported and is set up after installation, because a passphrase must never be passed to an installer: run &quot;jt-snmpd.exe user add librenms&quot; from the installation folder, then restart the service. Full instructions: https://jasoncheng7115.github.io/jt-snmpd/snmpv3.html" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Dialog Id="JtSettingsDlg" Width="370" Height="270" Title="jt-snmpd Setup">
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15"
                 Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Monitoring settings" />
        <!-- Width has to stop short of the banner icon. The banner bitmap is 370
             dialog units wide and the icon occupies roughly the last 40, so text
             may run to about unit 325. At Width=330 this description reached
             within 4 px of the icon and read as though it ran underneath it;
             measured from the rendered dialog, not estimated. 285 leaves a
             visible gap and still fits the text in two lines. -->
        <Control Id="Description" Type="Text" X="25" Y="23" Width="285" Height="20"
                 Transparent="yes" NoPrefix="yes"
                 Text="These two decide who may query this host. Both can be changed afterwards in config.json." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="NetLabel" Type="Text" X="20" Y="60" Width="330" Height="12"
                 NoPrefix="yes" Text="Management networks (required)" />
        <Control Id="NetHint" Type="Text" X="20" Y="73" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="Only these sources may query the agent, for example 10.0.0.0/24. Separate several with commas." />
        <Control Id="NetEdit" Type="Edit" X="20" Y="94" Width="330" Height="17"
                 Property="MANAGEMENTNETWORKS" Indirect="no" />

        <Control Id="CommLabel" Type="Text" X="20" Y="122" Width="330" Height="12"
                 NoPrefix="yes" Text="Community string (required)" />
        <Control Id="CommHint" Type="Text" X="20" Y="135" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="Equivalent to a read-only password. Left blank, the installer tries to carry one over from the built-in Windows SNMP service." />
        <Control Id="CommEdit" Type="Edit" X="20" Y="156" Width="330" Height="17"
                 Property="COMMUNITY" Indirect="no" />

        <Control Id="KeepMs" Type="CheckBox" X="20" Y="186" Width="330" Height="17"
                 Property="KEEPMSSNMP" CheckBoxValue="1"
                 Text="Keep the built-in Windows SNMP Service (by default it is disabled and restored on uninstall)" />

        <!-- This page is where the reader is deciding who may query the host, so
             it is where the absence of SNMPv3 is most likely to be read as "not
             supported". It is not asked for here on purpose. Y=210 sits between
             the checkbox at 186 and the bottom line at 234. -->
        <Control Id="V3Hint" Type="Text" X="20" Y="210" Width="330" Height="20"
                 NoPrefix="yes"
                 Text="SNMPv3 is also supported. It is not asked for here because a passphrase would end up in the installer log; it is set up after installation with jt-snmpd.exe user add." />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17"
                 Default="yes" Text="!(loc.WixUINext)">
          <!-- Refuse to continue without management networks. The default is deny by
               default and never Any/Any, and an empty list leaves the agent
               answering only loopback: installed, but not monitoring. -->
          <!-- The complaint is published first. Windows Installer ignores every
               event that follows a NewDialog on the same control, so putting the
               NewDialog first would make the ordering carry meaning it should
               not have to. -->
          <Publish Event="SpawnDialog" Value="JtNeedNetworksDlg" Order="1"
                   Condition="NOT MANAGEMENTNETWORKS" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2"
                   Condition="MANAGEMENTNETWORKS" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17"
                 Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="JtNeedNetworksDlg" Width="260" Height="85" Title="jt-snmpd Setup"
              NoMinimize="yes">
        <Control Id="Text" Type="Text" X="20" Y="15" Width="220" Height="40"
                 NoPrefix="yes"
                 Text="Please enter the management networks. Without them the agent answers local queries only, which means it is installed but not monitoring." />
        <Control Id="OK" Type="PushButton" X="100" Y="60" Width="56" Height="17"
                 Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>

      <!-- Splice the settings page into the standard flow:
           InstallDirDlg -> JtSettingsDlg -> VerifyReadyDlg

           **The Order matters and 3 was wrong.** WixUI_InstallDir already
           publishes NewDialog=VerifyReadyDlg on this control at Order 4, and
           when several NewDialog events are true the last one processed decides
           where the wizard goes. At Order 3 this row was published and then
           immediately overruled, so the settings page never appeared: 0.9.3 went
           straight from Destination Folder to Ready to install, and the
           installation then failed in the configure step because nothing had
           supplied the management networks. Verified by reading the
           ControlEvent table out of the built MSI.

           Order 5 puts this last. The condition mirrors the built-in row's, so a
           path that failed validation still goes to InvalidDirDlg rather than
           past it. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog"
               Value="JtSettingsDlg" Order="5"
               Condition="NOT Installed AND (WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;)" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog"
               Value="JtSettingsDlg" Order="5" Condition="NOT Installed" />
    </UI>

    <!-- The Id must carry the .ico extension. The MSI Icon table takes the file
         name from Name, and without an extension Windows does not recognise it as
         an icon: ARPPRODUCTICON then points at nothing and DisplayIcon in
         Add/Remove Programs ends up empty (measured). -->
    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />

  </Package>
</Wix>
